# Copy this file to .env and fill in real values.
# Never commit .env — it is listed in .gitignore.

# Optional — required only if using the Groq Cloud model (whisper-large-v3-turbo).
# Get your key at: https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Optional — Hugging Face token for gated / private models.
HF_TOKEN=hf_your_token_here

# Optional — Mozilla Data Collective API key for downloading Common Voice datasets.
# Get your key at: https://mozilladatacollective.com/profile/credentials
# Used in: sample_inputs/download_common_voice.py
MDC_API_KEY=your_mdc_api_key_here

# Gradio server port (default 7860)
GRADIO_PORT=7860
